# ---------------------------------------------------------------------------
# Profiling output — regenerated locally by profiling/profile_baseline.py
#   python3 profiling/profile_baseline.py --json profiling/baseline.json
#   python3 -m cProfile -s tottime demo.py > profiling/demo_profile.txt
#
# Kept in version control (not ignored): the harness and the written report
#   profiling/profile_baseline.py, profiling/BASELINE.md
# ---------------------------------------------------------------------------
profiling/baseline.json
profiling/baseline.prof
profiling/baseline_profile.txt
profiling/baseline_run.txt
profiling/demo_profile.txt
profiling/tmp/
profiling/*.tmp
profiling/*.snapshot
*.lprof
*.pstats

